# Cadena de conexión de tu base de datos Postgres (p.ej. Supabase: Project
# Settings -> Database -> Connection string -> URI, usando el modo "Session
# pooler" o "Transaction pooler" si tu host bloquea conexiones directas IPv6).
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres

# Código que hay que introducir para poder crear una cuenta. Sin esto,
# cualquiera que llegue a la URL puede registrarse.
INVITE_CODE=cambia-esto

# Secreto para firmar las sesiones (JWT). Si lo omites, el servidor genera
# uno y lo guarda en la base de datos (tabla settings) automáticamente.
# JWT_SECRET=

# Puerto en el que escucha el servidor (Render lo define automáticamente).
# PORT=3000
